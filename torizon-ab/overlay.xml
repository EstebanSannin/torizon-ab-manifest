<?xml version="1.0" encoding="UTF-8"?>
<!--
  torizon-ab overlay — the "outside BSP", vendor-agnostic layers that turn a
  stock Torizon manifest into the OSTree-free A/B variant.

  This file is <include>d by every torizon-ab/<vendor>/<channel>.xml. It is the
  ONE place our layers are declared, so adding a vendor never duplicates them.

  Nothing here is machine/vendor specific:
    - meta-swupdate   : SWUpdate backend (upstream only ships it under the syn BSP)
    - meta-rauc       : RAUC backend (not in the upstream manifest at all)
    - meta-torizon-ab : the A/B variant layer itself

  Revisions MUST be pinned to the exact commits we build & test (reproducibility).
  TODO(pin): replace the revisions below with the tested SHAs before first release.
-->
<manifest>
  <remote alias="repo" fetch="https://github.com" name="ab-github"/>

  <!-- SWUpdate backend. Upstream pins this under common-torizon/syn; we reuse a
       known-good rev here so it is available for every vendor, not just syn. -->
  <project name="sbabic/meta-swupdate" path="layers/meta-swupdate" remote="ab-github"
           revision="cb709b865a56be48cb17cbad149b69f793f3888b"/>

  <!-- RAUC backend. Not present in the upstream manifest; we add it. -->
  <!-- TODO(pin): set to the meta-rauc SHA matching the tested RAUC builds. -->
  <project name="rauc/meta-rauc" path="layers/meta-rauc" remote="ab-github"
           revision="master"/>

  <!-- The A/B variant layer. -->
  <!-- TODO(pin): bump to a release tag/SHA instead of tracking main. -->
  <project name="EstebanSannin/meta-torizon-ab" path="layers/meta-torizon-ab" remote="ab-github"
           revision="main"/>
</manifest>
