<?xml version="1.0" encoding="UTF-8"?>
<!--
  Toradex boards (tdx vendor), RELEASE channel (monthly/quarterly).
  Covers the Verdin machines: verdin-imx8mp, verdin-am62p.

  Shape = upstream vendor+channel manifest  +  our vendor-agnostic overlay.
  Upstream (Torizon OS 8) ships one entry point per vendor and channel under
  torizon/<vendor>/, so this is a straight 1:1 include.
-->
<manifest>
  <include name="torizon/tdx/release.xml"/>
  <include name="torizon-ab/overlay.xml"/>
</manifest>
